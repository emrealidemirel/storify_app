rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/profile.jpg {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /users/{uid}/reports/{reportId} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid) && resource == null
        && request.resource.size <= 128 * 1024
        && request.resource.contentType == 'application/json'
        && reportId.matches('[0-9]+[.]json');
      allow update: if false;
    }
  }
}
